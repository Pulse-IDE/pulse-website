---
import MetaHead from "@site/components/MetaHead.astro";
import type { Locale } from "@site/i18n/config";
import type { SiteCopy } from "@site/i18n/translations";

interface Props {
  locale: Locale;
  t: SiteCopy;
  title?: string;
  description?: string;
  wide?: boolean;
}

const { locale, t, wide = false } = Astro.props;
const title = Astro.props.title ?? t.meta.homeTitle;
const description = Astro.props.description ?? t.meta.homeDescription;
---

<!doctype html>
<html lang={locale}>
  <head>
    <MetaHead title={title} description={description} />
  </head>
  <body>
    <div class:list={["page", wide && "page-wide"]}>
      <slot />
    </div>
  </body>
</html>

<style is:global>
  @import "../styles/global.css";
</style>
