---
import MetaHead from "@site/components/MetaHead.astro";
import WebChrome from "@site/components/WebChrome.astro";
import type { Locale } from "@site/i18n/config";
import type { SiteCopy } from "@site/i18n/translations";
import PulseWebApp from "@site/components/PulseWebApp";

interface Props {
  locale: Locale;
  t: SiteCopy;
}

const { locale, t } = Astro.props;
---

<!doctype html>
<html lang={locale}>
  <head>
    <MetaHead title={t.meta.webTitle} description={t.meta.webDescription} />
  </head>
  <body class="workbench-body">
    <WebChrome locale={locale} t={t} />
    <div class="workbench-shell">
      <PulseWebApp client:only="react" />
    </div>
  </body>
</html>

<style is:global>
  @import "../styles/global.css";
  @import "../styles/workbench.css";
</style>
