---
import type { SiteCopy } from "@site/i18n/translations";

interface Props {
  t: SiteCopy;
}

const { t } = Astro.props;
const icons = ["⚡", "◫", "🧩", "▸", "⎇", "↑"];
---

<section class="features-section">
  <header class="section-head">
    <h2>{t.features.heading}</h2>
    <p>{t.features.intro}</p>
  </header>
  <div class="features">
    {t.features.items.map((item, i) => (
      <article class="feature-card">
        <div class="feature-card__icon">{icons[i] ?? "•"}</div>
        <h3>{item.title}</h3>
        <p>{item.body}</p>
      </article>
    ))}
  </div>
</section>
