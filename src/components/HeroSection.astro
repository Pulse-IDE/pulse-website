---
import IdeShowcase from "@site/components/IdeShowcase.astro";
import { localizedPath, type Locale } from "@site/i18n/config";
import type { SiteCopy } from "@site/i18n/translations";

interface Props {
  locale: Locale;
  t: SiteCopy;
}

const { locale, t } = Astro.props;
---

<section class="hero">
  <div class="hero-copy">
    <p class="hero-eyebrow">Pulse IDE</p>
    <h1>{t.hero.title}</h1>
    <p>{t.hero.subtitle}</p>
    <div class="hero-badges">
      {t.hero.badges.map((badge) => (
        <span class="badge">{badge}</span>
      ))}
    </div>
    <div class="hero-actions">
      <a class="btn btn--primary" href={localizedPath(locale, "/download")}>{t.hero.ctaDownload}</a>
      <a class="btn btn--ghost" href={localizedPath(locale, "/web")}>{t.hero.ctaWeb}</a>
    </div>
  </div>
  <IdeShowcase locale={locale} />
</section>
