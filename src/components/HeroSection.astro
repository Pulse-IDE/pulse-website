---
import { localizedPath, type Locale } from "@site/i18n/config";
import type { SiteCopy } from "@site/i18n/translations";

interface Props {
  locale: Locale;
  t: SiteCopy;
}

const { locale, t } = Astro.props;
---

<section class="hero">
  <div class="hero-copy">
    <h1>{t.hero.title}</h1>
    <p>{t.hero.subtitle}</p>
    <div class="hero-badges">
      {t.hero.badges.map((badge) => (
        <span class="badge">{badge}</span>
      ))}
    </div>
    <div class="hero-actions">
      <a class="primary-download" href={localizedPath(locale, "/download")}>{t.hero.ctaDownload}</a>
      <a class="secondary-download" href={localizedPath(locale, "/web")}>{t.hero.ctaWeb}</a>
    </div>
  </div>
  <aside class="hero-card">
    <h2>{t.home.webCardTitle}</h2>
    <p class="card-body">{t.home.webCardBody}</p>
    <a class="primary-download" href={localizedPath(locale, "/web")}>{t.home.webCardAction}</a>
  </aside>
</section>
