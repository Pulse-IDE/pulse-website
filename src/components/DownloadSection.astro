---
import { assetUrl, releaseAssets } from "@site/data/releases";
import type { SiteCopy } from "@site/i18n/translations";
import DownloadMatrix from "@site/components/DownloadMatrix.astro";

interface Props {
  t: SiteCopy;
  showMatrix?: boolean;
}

const { t, showMatrix = true } = Astro.props;
---

<section class="download-section" id="downloads">
  <header class="section-head">
    <h2>{t.download.heading}</h2>
    <p>{t.download.intro}</p>
  </header>
  <div class="download-hero-card">
    <h3>{t.download.recommended}</h3>
    <div
      id="download-root"
      data-assets={JSON.stringify(
        releaseAssets.map((item) => ({
          ...item,
          url: assetUrl(item.fileName),
        })),
      )}
      data-detecting={t.download.detecting}
    >
      <a id="download-primary" class="primary-download" href={assetUrl("Pulse_x86_64.AppImage")}>
        Download Pulse IDE
      </a>
      <p id="detected-os" class="detected-os">{t.download.detecting}</p>
    </div>
  </div>
  {showMatrix ? (
    <>
      <h3 class="matrix-title">{t.download.allPlatforms}</h3>
      <DownloadMatrix />
    </>
  ) : null}
</section>

<script>
  type TargetOs = "macos" | "linux" | "windows";
  interface ReleaseAssetWire {
    os: TargetOs;
    arch: string;
    label: string;
    hint: string;
    url: string;
    recommended?: boolean;
  }

  function detectOs(): TargetOs {
    const ua = navigator.userAgent.toLowerCase();
    const platform = navigator.platform.toLowerCase();
    if (platform.includes("mac") || ua.includes("mac os")) {
      return "macos";
    }
    if (platform.includes("win") || ua.includes("windows")) {
      return "windows";
    }
    return "linux";
  }

  function detectArch(): string {
    const ua = navigator.userAgent.toLowerCase();
    if (ua.includes("arm") || ua.includes("aarch64")) {
      return "aarch64";
    }
    if (ua.includes("win64") || ua.includes("x64") || ua.includes("x86_64")) {
      return "x86_64";
    }
    return "universal";
  }

  const root = document.getElementById("download-root");
  const primary = document.getElementById("download-primary") as HTMLAnchorElement | null;
  const detected = document.getElementById("detected-os");
  if (root && primary && detected) {
    const assets = JSON.parse(root.dataset.assets ?? "[]") as ReleaseAssetWire[];
    const os = detectOs();
    const arch = detectArch();
    const preferred =
      assets.find((item) => item.os === os && item.arch === arch && item.recommended) ??
      assets.find((item) => item.os === os && item.recommended) ??
      assets.find((item) => item.os === os) ??
      assets.find((item) => item.recommended) ??
      assets[0];
    if (preferred) {
      primary.href = preferred.url;
      primary.textContent = `Download ${preferred.label}`;
      detected.textContent = `${preferred.label} · ${preferred.hint}`;
    }
  }
</script>
