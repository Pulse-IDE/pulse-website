---
import BaseLayout from "@site/layouts/BaseLayout.astro";
import SiteHeader from "@site/components/SiteHeader.astro";
import SiteFooter from "@site/components/SiteFooter.astro";
import HeroSection from "@site/components/HeroSection.astro";
import FeaturesSection from "@site/components/FeaturesSection.astro";
import CtaBand from "@site/components/CtaBand.astro";
import { pageContext } from "@site/i18n/pageContext";

const { locale, t } = pageContext();
---

<BaseLayout locale={locale} t={t} title={t.meta.homeTitle} description={t.meta.homeDescription} wide>
  <SiteHeader locale={locale} t={t} active="home" />
  <HeroSection locale={locale} t={t} />
  <FeaturesSection t={t} />
  <CtaBand locale={locale} t={t} />
  <SiteFooter locale={locale} t={t} />
</BaseLayout>
